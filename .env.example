# ---------------------------------------------------------------------------
# Career Services Automatic Event Reminder System
# BITS Pilani, Dubai Campus
# Copy this file to .env and fill in the values you need.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
# Public base URL used to build registration and feedback links inside messages.
PUBLIC_BASE_URL=http://localhost:3000

# SQLite database file
DATABASE_FILE=./data/reminders.db

# Institutional defaults used by the message templates
ORG_NAME=Career Services, BITS Pilani Dubai Campus
ORG_SHORT_NAME=Career Services
ORG_EMAIL=careerservices@dubai.bits-pilani.ac.in
ORG_PHONE=+971 4 420 0700
DEFAULT_TIMEZONE=Asia/Dubai

# ---------------------------------------------------------------------------
# Delivery
# DRY_RUN=true records every message in the outbox and renders it in the UI
# without contacting any provider. Keep it true until the SMTP details below
# have been verified against a test event.
# ---------------------------------------------------------------------------
DRY_RUN=true

# Email (SMTP). Leave SMTP_HOST empty to keep email in dry-run preview mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Career Services <careerservices@dubai.bits-pilani.ac.in>
MAIL_REPLY_TO=careerservices@dubai.bits-pilani.ac.in

# SMS and WhatsApp are delivered by POSTing a JSON payload to a gateway of your
# choice. Leave the URL empty to keep the channel in dry-run preview mode.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# How often the worker looks for due messages, in seconds.
SCHEDULER_INTERVAL_SECONDS=30
# Maximum messages dispatched per tick.
SCHEDULER_BATCH_SIZE=50
# A scheduled message older than this is dropped instead of sent late.
SCHEDULER_MAX_LATENESS_MINUTES=180
# Set to false to run the web app without the background worker.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Access
# Single shared password for the staff console. Leave empty to disable the
# login screen (only appropriate on a trusted machine).
# ---------------------------------------------------------------------------
STAFF_PASSWORD=
SESSION_SECRET=change-me-before-deploying

# Load a small set of demonstration students and events on first start.
SEED_DEMO_DATA=true
