# ---------------------------------------------------------------------------
# Career Services Automatic Event Reminder System
# BITS Pilani, Dubai Campus
# Copy this file to .env and fill in the values you need.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
# Public base URL used to build registration and feedback links inside messages.
PUBLIC_BASE_URL=http://localhost:3000

# SQLite database file
DATABASE_FILE=./data/reminders.db

# Institutional defaults used by the message templates
ORG_NAME=Career Services, BITS Pilani Dubai Campus
ORG_SHORT_NAME=Career Services
ORG_EMAIL=careerservices@dubai.bits-pilani.ac.in
ORG_PHONE=+971 4 420 0700
DEFAULT_TIMEZONE=Asia/Dubai

# ---------------------------------------------------------------------------
# Delivery
#
#   draft    The system works out who gets what and when, renders every message
#            in full, then holds it in the To send queue for a member of staff
#            to hand to whoever sends campus mail. Nothing is delivered from
#            here. This is the default and needs no other setting in this file.
#   send     Delivered directly over SMTP and the gateways below.
#   preview  Pretends to send, for testing. Nothing leaves the machine and
#            nothing waits to be handed over.
# ---------------------------------------------------------------------------
DELIVERY_MODE=draft

# ---------------------------------------------------------------------------
# Everything below this line is only read when DELIVERY_MODE=send.
# Leave it alone while the system is drafting.
# ---------------------------------------------------------------------------

# Email (SMTP). Many campuses run an internal relay that accepts mail from an
# approved server without credentials: in that case set SMTP_HOST and SMTP_PORT
# and leave SMTP_USER and SMTP_PASS empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Career Services <careerservices@dubai.bits-pilani.ac.in>
MAIL_REPLY_TO=careerservices@dubai.bits-pilani.ac.in

# SMS and WhatsApp are delivered by POSTing a JSON payload to a gateway of your
# choice. Leave the URL empty to keep the channel in dry-run preview mode.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Scheduler
#
# The worker runs whatever the delivery mode. While drafting it keeps the
# schedule up to date and fills the To send queue; it just never delivers.
# ---------------------------------------------------------------------------
# How often the worker looks for due messages, in seconds.
SCHEDULER_INTERVAL_SECONDS=30
# Maximum messages dispatched per tick.
SCHEDULER_BATCH_SIZE=50
# A scheduled message older than this is dropped instead of sent late.
# Not applied while drafting: a message waiting for a person is never discarded.
SCHEDULER_MAX_LATENESS_MINUTES=180
# Set to false to run the web app without the background worker.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Access
# Single shared password for the staff console. Leave empty to disable the
# login screen (only appropriate on a trusted machine).
# ---------------------------------------------------------------------------
STAFF_PASSWORD=
SESSION_SECRET=change-me-before-deploying

# Load a small set of demonstration students and events on first start.
SEED_DEMO_DATA=true
